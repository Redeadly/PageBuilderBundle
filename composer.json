{
    "name": "acseo/pagebuilder-bundle",
    "description": "This bundle provides a PageBuilder Solution built on GrapesJS.",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Nicolas Potier",
            "email": "nicolas.potier@acseo.fr"
        }
    ],
    "require": {
        "symfony/framework-bundle": "^7",
        "symfony/http-client": "^7",
        "symfony/twig-bundle": "^7",
        "symfony/messenger": "^7",
        "symfony/dom-crawler": "^7",
        "symfony/validator": "^7",
        "symfony/ux-live-component": "^2.25",
        "doctrine/doctrine-bundle": "^2.11",
        "doctrine/orm": "^3.5"
    },
    "require-dev": {
        "symfony/test-pack": "1.2.*",
        "symfony/options-resolver": "^7",
        "friendsofphp/php-cs-fixer": "^3.85"
    },
    "autoload": {
        "psr-4": { "ACSEO\\PageBuilderBundle\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": {
            "ACSEO\\PageBuilderBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
        }
    }
}
