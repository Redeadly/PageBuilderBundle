{
    "name": "acseo/pagebuilder-bundle",
    "description": "This bundle provides a PageBuilder Solution built on GrapesJS.",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Nicolas Potier",
            "email": "nicolas.potier@acseo.fr"
        }
    ],
    "require": {
        "symfony/framework-bundle": "^7 | ^8",
        "symfony/http-client": "^7 | ^8",
        "symfony/twig-bundle": "^7 | ^8",
        "symfony/messenger": "^7 | ^8",
        "symfony/dom-crawler": "^7 | ^8",
        "symfony/validator": "^7 | ^8",
        "symfony/ux-live-component": "^2",
        "doctrine/doctrine-bundle": "^2 | ^3",
        "doctrine/orm": "^3"
    },
    "require-dev": {
        "symfony/test-pack": "1.2.*",
        "symfony/options-resolver": "^7 | ^8",
        "friendsofphp/php-cs-fixer": "^3"
    },
    "autoload": {
        "psr-4": { "ACSEO\\PageBuilderBundle\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": {
            "ACSEO\\PageBuilderBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
        }
    }
}
