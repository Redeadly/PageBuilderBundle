{
    "name": "acseo/pagebuilder-bundle",
    "description": "This bundle provides a PageBuilder Solution built on GrapesJS.",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Nicolas Potier",
            "email": "nicolas.potier@acseo.fr"
        }
    ],
    "require": {
        "symfony/framework-bundle": "7.3.*",
        "symfony/http-client": "7.3.*",
        "symfony/twig-bundle": "7.3.*",
        "symfony/messenger": "7.3.*",
        "symfony/dom-crawler": "7.3.*",
        "symfony/validator": "7.3.*",
        "doctrine/doctrine-bundle": "^2.11",
        "doctrine/orm": "^2.17"
    },
    "require-dev": {
        "symfony/test-pack": "1.2.*"
    },
    "autoload": {
        "psr-4": { "ACSEO\\PageBuilderBundle\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": {
            "ACSEO\\PageBuilderBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
        }
    }
}
